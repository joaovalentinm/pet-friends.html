# =====================================================================
# JOÃO CONTENT INTELLIGENCE — variáveis de ambiente
# Copie para .env.local (dev) e configure também no painel da Vercel.
# Nunca faça commit de valores reais.
# =====================================================================

# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# E-mails autorizados a entrar (separados por vírgula). O primeiro acesso vira "owner".
ALLOWED_EMAILS=

# --- Rotina diária (obrigatório em produção) ---
# Segredo enviado pela Vercel Cron no header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
APP_URL=

# --- IA (obrigatório para análises, tendências e roteiros) ---
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
AI_EFFORT=medium

# --- Radar viral ---
YOUTUBE_API_KEY=

# --- Meta / Instagram Graph API (conta profissional de João) ---
META_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=
META_GRAPH_VERSION=v23.0

# --- TikTok Research API (requer aprovação) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- Metricool (opcional, plano com API) ---
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=

# --- Transcrição (opcional) ---
ASSEMBLYAI_API_KEY=

# --- Notificações (opcional) ---
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TO=
