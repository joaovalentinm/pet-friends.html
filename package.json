{
  "name": "pet-friends",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-font": "~58.0.11",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "nativewind": "4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "3.4.19"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "^58.0.24",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.14",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|nativewind|react-native-css-interop)"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
